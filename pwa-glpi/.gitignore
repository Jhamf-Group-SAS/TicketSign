# ─── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.out
logs/
**/logs/

# ─── Build artifacts ───────────────────────────────────────────────────────────
dist/
**/dist/
dev-dist/
**/dev-dist/
client/build/
build_*.txt
build_*.log

# ─── Uploads, PDFs generados y archivos temporales (datos sensibles de clientes) ─
server/uploads/
server/temp/

# ─── Archivos de diagnóstico / debugging / scripts temporales ──────────────────
server/*.log
server/*.json
server/tmp_*.js
server/test_*.js
server/debug_*.log
server/session_*.log
server/session_*.json
server/diag_*.json
server/*_dump.json
server/*_out.log
server/*_out*.log
!server/package.json
!server/package-lock.json

# ─── Archivos de diagnóstico raíz ──────────────────────────────────────────────
*.json
!package.json
!package-lock.json
!**/package.json
!**/package-lock.json

# ─── Sistema operativo / IDE ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.suo
*.tmp

