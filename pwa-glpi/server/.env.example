# =============================================================
# TicketSign — Variables de Entorno de Producción
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio de código.
# =============================================================

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production

# ─── Base de Datos ───────────────────────────────────────────────────────────
# Formato: mongodb://usuario:contraseña@host:puerto/basededatos
MONGO_URI=mongodb://localhost:27017/ticketsign

# ─── Seguridad / JWT ─────────────────────────────────────────────────────────
# Cadena aleatoria de al menos 64 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_MINIMO_64_CARACTERES

# ─── Cifrado de Datos (AES-256) ──────────────────────────────────────────────
# Cadena hexadecimal de exactamente 64 caracteres (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [C-01] REQUERIDO: El servidor NO arrancará sin esta variable. No tiene valor por defecto.
ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_HEX_DE_64_CARACTERES

# ─── Acceso de Emergencia (Solo sin GLPI configurado) ────────────────────────
# Define estas variables SOLO si necesitas acceso antes de configurar GLPI.
# Usar contraseña robusta. Si no se definen, el login de emergencia queda desactivado.
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# ─── Notificaciones WhatsApp (Opcional) ──────────────────────────────────────
# WHATSAPP_API_URL=https://api.whatsapp.example.com
# WHATSAPP_API_KEY=tu_api_key_aqui
